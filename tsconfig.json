{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2021", "DOM", "DOM.Iterable"]
  },
  "include": ["main.ts", "src/**/*.ts"]
}

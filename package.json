{
  "name": "obsidian-deepseek-chat",
  "version": "0.2.0",
  "description": "Unofficial DeepSeek chat for Obsidian with your own API key: web search, deep search, read links, files, safety check, titles, text-to-speech and speech input.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p . && node esbuild.config.mjs production",
    "check": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "node esbuild.config.mjs test",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "deepseek",
    "chat",
    "ai"
  ],
  "author": "kiven大汉堡",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KivenBig/obsidian-deepseek-chat.git"
  },
  "bugs": {
    "url": "https://github.com/KivenBig/obsidian-deepseek-chat/issues"
  },
  "homepage": "https://github.com/KivenBig/obsidian-deepseek-chat#readme",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.6.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "obsidian": "1.12.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
